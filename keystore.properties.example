# Copy to keystore.properties and fill in. That file is gitignored.
# CI may instead supply MEWDEKO_KEYSTORE, MEWDEKO_KEYSTORE_PASSWORD,
# MEWDEKO_KEY_ALIAS and MEWDEKO_KEY_PASSWORD as environment variables.
storeFile=/absolute/path/to/mewdeko-release.jks
storePassword=
keyAlias=mewdeko
keyPassword=
